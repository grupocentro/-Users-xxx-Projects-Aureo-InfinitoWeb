# =============================================================================
# Infinito Water Park — Variables de entorno (template)
# =============================================================================
# Copiá este archivo como `.env` y completá los valores reales.
# NUNCA commitees `.env`. Sólo `.env.example` queda versionado.
#
# Las variables con prefijo VITE_ se exponen al cliente (frontend).
# Solo poner ahí valores PÚBLICOS (Supabase anon key es público por diseño).
# =============================================================================


# --- Supabase (frontend / público) -------------------------------------------
# Proyecto: dashboard.supabase.com → Project Settings → API
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""


# =============================================================================
# SECRETS SERVER-SIDE (NO van en este archivo — viven en Supabase Edge Functions)
# =============================================================================
# Estas variables se configuran en:
#   Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# Edge functions que las consumen:
#   supabase/functions/create-payment/index.ts
#   supabase/functions/webhook-mercadopago/index.ts
#
# - MP_ACCESS_TOKEN              MercadoPago Access Token (Sandbox o Producción)
# - SUPABASE_SERVICE_ROLE_KEY    Provisto automáticamente por Supabase
# - SUPABASE_URL                 Provisto automáticamente por Supabase
# - SUPABASE_ANON_KEY            Provisto automáticamente por Supabase
#
# NUNCA expongas estos valores en el frontend ni en este archivo.
# =============================================================================
